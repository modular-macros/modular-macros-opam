  "ocaml-variants" {= "5.5.0+macocaml-prototype-2026-08-06"}
  "dune" {>= "3.9"}
  "ocaml" {>= "4.07.0"}
  "integers" {with-test & >= "0.2.2"}
  "ctypes" {= "0.24.0+macocaml"}
  "dune-configurator"
  "conf-pkg-config"
